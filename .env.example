# =============================================================================
# Payment Operations Console - local workspace configuration
#
# Copy to .env and fill in real values, then run ./setup.sh
#   cp .env.example .env
#
# .env is gitignored and is also listed in .bobignore, so the agent cannot read
# it. Nothing in here should ever be committed.
# =============================================================================

# --- Jira -------------------------------------------------------------------
# JIRA_HOST      your Atlassian site, no scheme (e.g. meridian.atlassian.net)
# JIRA_EMAIL     the account the API token belongs to
# JIRA_API_TOKEN https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Board/project the modernization tickets live in (e.g. MPO).
JIRA_PROJECT_KEY=
# Default assignee for subtasks the agent creates: Atlassian accountId or email.
JIRA_ASSIGNEE=
# Issue type name used for subtasks on your site ("Subtask" or "Sub-task").
JIRA_SUBTASK_TYPE=Subtask

# --- Confluence -------------------------------------------------------------
# Served by the uvx package mcp-atlassian; limited to page read/write + search.
# CONFLUENCE_URL       full wiki base URL, e.g. https://meridian.atlassian.net/wiki
# CONFLUENCE_USERNAME  same account email as Jira
# CONFLUENCE_API_TOKEN same token page as above (one token works for both)
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# --- Figma ------------------------------------------------------------------
# Personal access token with file read scope:
#   Figma -> Settings -> Security -> Personal access tokens
# Needed only for design-system work (rule 09-design-system-fidelity.md).
FIGMA_ACCESS_TOKEN=

# --- GitHub -----------------------------------------------------------------
# No GitHub MCP server is configured: repository operations (pull requests,
# checks, releases) go through the `gh` CLI, which is assumed to be installed
# and already authenticated -- verify with:
#   gh auth status
#
# These two are not consumed by .bob/mcp.json; they are here so scripts and
# workflow docs have one place to read the repo coordinates from.
GITHUB_OWNER=
GITHUB_REPO_NAME=meridian-payment-ops
