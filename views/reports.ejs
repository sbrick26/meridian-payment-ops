<%#
  ---------------------------------------------------------------------------
  View:     reports
  Owner:    payments-platform-team
  Control:  AC-3 (data access), AU-2 (audit)
            SOX/PCI: PCI Req. 7 (access control), PCI Req. 10 (audit trail)
  Reviewed: 2026-08-13
  ---------------------------------------------------------------------------
%>
<%- include('partials/header', { pageTitle: 'Reports' }) %>

  <ul class="breadcrumb">
    <li><a href="/">Dashboard</a> <span class="divider">/</span></li>
    <li class="active">Reports</li>
  </ul>

  <div class="page-header">
    <h1>AP Payables Reports <small>run date <%= asOf %> &middot; source: PAYOPS payables file</small></h1>
  </div>

  <div class="well well-small no-print">
    <b>Extracts</b> &nbsp;
    <a href="/reports/export.csv" class="btn btn-small">Export CSV (held payments)</a>
    <a href="/reports/export.csv?status=ALL" class="btn btn-small">Export CSV (all items)</a>
    <a href="/reports/export.csv?status=ESCALATED" class="btn btn-small">Export CSV (escalated)</a>
    <a href="/api/exceptions.xml" class="btn btn-small">ERP extract XML</a>
    <input type="button" class="btn btn-small" value="Print report" onclick="return printPage();">
    <span class="muted">&nbsp; CSV opens in Excel. Do not email extracts outside the company.</span>
  </div>

  <div class="row">
    <div class="span5">
      <div class="section-title">R-01 Held payments by status (including closed)</div>
      <table class="table table-bordered table-condensed table-striped report-table">
        <thead>
          <tr><th>Status</th><th class="num">Items</th><th class="num">Value</th><th class="num">Avg age</th></tr>
        </thead>
        <tbody>
        <% for (var i = 0; i < byStatus.length; i++) { %>
          <tr>
            <td><%= byStatus[i].status %></td>
            <td class="num"><%= byStatus[i].n %></td>
            <td class="num"><%= u.money(byStatus[i].v) %></td>
            <td class="num"><%= byStatus[i].a.toFixed(1) %>d</td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>

    <div class="span5">
      <div class="section-title">R-02 Held payments by payment method</div>
      <table class="table table-bordered table-condensed table-striped report-table">
        <thead>
          <tr><th>Method</th><th class="num">Items</th><th class="num">Value</th></tr>
        </thead>
        <tbody>
        <% for (var i = 0; i < byType.length; i++) { %>
          <tr>
            <td><%= byType[i].ptype %></td>
            <td class="num"><%= byType[i].n %></td>
            <td class="num"><%= u.money(byType[i].v) %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="row">
    <div class="span5">
      <div class="section-title">R-03 Held payments by vendor country</div>
      <table class="table table-bordered table-condensed table-striped report-table">
        <thead>
          <tr><th>Country</th><th class="num">Items</th><th class="num">Value</th></tr>
        </thead>
        <tbody>
        <% for (var i = 0; i < byCountry.length; i++) { %>
          <tr>
            <td><%= byCountry[i].country %></td>
            <td class="num"><%= byCountry[i].n %></td>
            <td class="num"><%= u.money(byCountry[i].v) %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>

    <div class="span5">
      <div class="section-title">R-04 Held payments by age band</div>
      <table class="table table-bordered table-condensed table-striped report-table">
        <thead>
          <tr><th>Age band</th><th class="num">Items</th><th class="num">Value</th><th>&nbsp;</th></tr>
        </thead>
        <tbody>
        <% for (var i = 0; i < byAge.length; i++) { %>
          <tr>
            <td><%= byAge[i].bucket %></td>
            <td class="num"><%= byAge[i].n %></td>
            <td class="num"><%= u.money(byAge[i].v) %></td>
            <td><span class="bar" role="img"
                  aria-label="<%= byAge[i].bucket %>: <%= byAge[i].n %> items"
                  style="width: <%= byAge[i].n %>px">&nbsp;</span></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="section-title">R-05 Held payments by hold reason</div>
  <table class="table table-bordered table-condensed table-striped report-table">
    <thead>
      <tr><th>Hold code</th><th>Hold reason</th><th class="num">Items</th><th>&nbsp;</th></tr>
    </thead>
    <tbody>
    <% for (var i = 0; i < byReason.length; i++) { %>
      <tr>
        <td><b><%= byReason[i].reason_code %></b></td>
        <td><%= byReason[i].reason_text %></td>
        <td class="num"><%= byReason[i].n %></td>
        <td><span class="bar" role="img"
              aria-label="<%= byReason[i].reason_code %>: <%= byReason[i].n %> items"
              style="width: <%= byReason[i].n * 4 %>px">&nbsp;</span></td>
      </tr>
    <% } %>
    </tbody>
  </table>

  <div class="section-title">R-06 Open workload by AP clerk</div>
  <table class="table table-bordered table-condensed table-striped report-table">
    <thead>
      <tr><th>Clerk</th><th>Team</th><th class="num">Items</th><th class="num">Value held</th><th class="num">Avg age</th></tr>
    </thead>
    <tbody>
    <% for (var i = 0; i < byClerk.length; i++) { %>
      <tr>
        <td><%= byClerk[i].clerk %></td>
        <td><%= byClerk[i].team %></td>
        <td class="num"><%= byClerk[i].n %></td>
        <td class="num"><%= u.money(byClerk[i].v) %></td>
        <td class="num"><%= byClerk[i].a.toFixed(1) %>d</td>
      </tr>
    <% } %>
    </tbody>
  </table>

  <p class="report-note">
    Reports R-01 to R-06 replace the green bar listings withdrawn in 2013. The
    monthly payables control pack is produced from the same extract by the
    Finance MI team &mdash; if a figure here does not agree with the pack, raise a
    call with the service desk quoting application PAYOPS before amending anything.
  </p>

<%- include('partials/footer') %>
