{
  "mcpServers": {
    "jira": {
      "command": "node",
      "args": [
        "/Users/swayambarik/Documents/CE/align-sf-modernization/mcp-servers/jira-server/src/index.js"
      ],
      "env": {
        "JIRA_HOST": "${JIRA_HOST}",
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_PROJECT_KEY": "${JIRA_PROJECT_KEY}",
        "JIRA_ASSIGNEE": "${JIRA_ASSIGNEE}",
        "JIRA_SUBTASK_TYPE": "${JIRA_SUBTASK_TYPE}"
      },
      "alwaysAllow": [
        "jira_get_assigned_tickets",
        "jira_get_ticket_details",
        "jira_update_status",
        "jira_add_comment",
        "jira_create_subtask",
        "jira_get_subtasks",
        "jira_attach_file"
      ]
    },
    "figma-console": {
      "command": "node",
      "args": [
        "/Users/swayambarik/Documents/CE/align-sf-modernization/mcp-servers/figma-lite/figma-mcp-lite.mjs",
        "npx",
        "-y",
        "figma-console-mcp@1.39.1"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}",
        "LOG_LEVEL": "warn",
        "MCP_ALLOW_TOOLS": "figma_get_status,figma_execute,figma_capture_screenshot,figma_navigate,figma_reconnect,figma_get_component_for_development,figma_search_components,figma_post_comment,figma_get_comments,figma_diagnose,figma_set_image_fill",
        "FIGMA_WS_PORT": "9223"
      },
      "timeout": 240,
      "alwaysAllow": [
        "figma_get_status",
        "figma_execute",
        "figma_capture_screenshot",
        "figma_navigate",
        "figma_reconnect",
        "figma_get_component_for_development",
        "figma_search_components",
        "figma_post_comment",
        "figma_get_comments",
        "figma_diagnose",
        "figma_set_image_fill",
        "figma_find_nodes",
        "figma_export_frame",
        "figma_set_image_fill_from_file"
      ]
    }
  }
}
