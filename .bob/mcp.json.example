{
  "mcpServers": {
    "jira": {
      "command": "node",
      "args": [
        "/Users/swayambarik/Documents/CE/align-sf-modernization/mcp-servers/jira-server/src/index.js"
      ],
      "env": {
        "JIRA_HOST": "${JIRA_HOST}",
        "JIRA_EMAIL": "${JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}",
        "JIRA_PROJECT_KEY": "${JIRA_PROJECT_KEY}",
        "JIRA_ASSIGNEE": "${JIRA_ASSIGNEE}",
        "JIRA_SUBTASK_TYPE": "${JIRA_SUBTASK_TYPE}"
      },
      "alwaysAllow": [
        "jira_get_assigned_tickets",
        "jira_get_ticket_details",
        "jira_update_status",
        "jira_add_comment",
        "jira_create_subtask",
        "jira_get_subtasks",
        "jira_attach_file"
      ]
    },
    "meridian-ops": {
      "command": "node",
      "args": [
        "/Users/swayambarik/Documents/CE/align-sf-modernization/mcp-servers/meridian-ops/index.mjs"
      ],
      "timeout": 300,
      "alwaysAllow": [
        "ops_start_console"
      ]
    }
  }
}
